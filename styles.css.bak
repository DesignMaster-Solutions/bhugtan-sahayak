:root {
  --ink: #1b1f24;
  --muted: #55606b;
  --green: #14532d;
  --gold: #f4c542;
  --paper: #fbfaf7;
  --line: #d9dde2;
  --soft: #eef5ef;
  font: 17px/1.55 system-ui, -apple-system, "Segoe UI", "Noto Sans", "Noto Sans Devanagari", sans-serif;
  color: var(--ink);
  background: var(--paper);
}
* { box-sizing: border-box; }
body { margin: 0; }
.wrap { max-width: 40rem; margin: 0 auto; padding: 0 1rem; }
.top { background: var(--green); color: #fff; border-bottom: 4px solid var(--gold); }
.top-row { display: flex; align-items: center; justify-content: space-between; min-height: 3.25rem; gap: .5rem; }
.lang { display: flex; gap: .25rem; flex-wrap: nowrap; }
.lang button { background: transparent; color: #fff; border-color: rgba(255,255,255,.45); padding: .35rem .7rem; min-height: 2.5rem; }
.lang button[aria-pressed="true"] { background: #fff; color: var(--green); }
main { padding-top: 1.5rem; padding-bottom: 2rem; }
h1 { font-size: 1.6rem; line-height: 1.25; margin: .5rem 0 .75rem; }
h2 { font-size: 1.3rem; line-height: 1.35; margin: .75rem 0 1rem; }
h3 { font-size: 1.15rem; line-height: 1.35; margin: .2rem 0 .5rem; }
h4 { font-size: 1rem; margin: 1rem 0 .3rem; color: var(--green); }
h1:focus, h2:focus { outline: none; }
button, .btn {
  font: inherit; cursor: pointer; border: 1.5px solid var(--green); background: #fff; color: var(--green);
  border-radius: 10px; padding: .7rem 1.1rem; min-height: 3rem; white-space: nowrap; text-decoration: none;
  display: inline-flex; align-items: center; transition: background-color .15s ease, transform .1s ease;
}
button:active, .btn:active { transform: scale(.98); }
button:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
.primary { background: var(--green); color: #fff; font-weight: 600; }
.link { border: 0; background: none; text-decoration: underline; padding: .7rem .4rem; }
.step { color: var(--muted); margin: 0 0 .3rem; font-size: .9rem; }
.bar { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; }
.bar span { display: block; height: 100%; background: var(--gold); transition: width .25s ease; }
.answers { display: grid; gap: .6rem; margin: 1.25rem 0 .5rem; }
.opt { width: 100%; text-align: left; white-space: normal; gap: .8rem; min-height: 3.6rem; }
.opt .ico { font-size: 1.6rem; line-height: 1; flex: none; width: 2rem; text-align: center; }
.opt .lbl { display: block; font-size: 1.05rem; font-weight: 500; }
.opt small { display: block; color: var(--muted); font-size: .85rem; }
.opt.chosen { background: var(--soft); border-width: 2.5px; }
.hint { color: var(--muted); font-size: .92rem; }
.actions { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin: 1rem 0; }
.cause { background: #fff; border: 1px solid var(--line); border-left: 5px solid var(--gold); border-radius: 0 10px 10px 0; padding: .9rem 1rem; margin-bottom: 1rem; }
.cause p { margin: .3rem 0; }
.src { font-size: .85rem; color: var(--muted); }
.checks, .points { padding-left: 1.1rem; margin: .3rem 0; }
.checks li { margin-bottom: .6rem; }
.checks a { font-weight: 600; }
.letter { margin-top: 1rem; border-top: 1px dashed var(--line); padding-top: .6rem; }
.letter summary { cursor: pointer; font-weight: 600; color: var(--green); min-height: 2.75rem; display: flex; align-items: center; }
.letter pre { white-space: pre-wrap; font: 15px/1.55 inherit; font-family: inherit; background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: .8rem; margin: .5rem 0; }
.worked { background: var(--soft); border-radius: 10px; padding: .8rem 1rem; margin: 1.5rem 0 1rem; }
.otp { font-weight: 600; color: var(--ink); }
.foot { color: var(--muted); font-size: .85rem; border-top: 1px solid var(--line); padding-top: 1rem; padding-bottom: 2rem; }
@media (max-width: 400px) {
  button, .btn { padding: .6rem .8rem; }
  .actions { gap: .4rem; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
table { border-collapse: collapse; width: 100%; margin: .5rem 0 1.25rem; background: #fff; }
th, td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
thead th { color: var(--muted); font-weight: 500; font-size: .85rem; }
